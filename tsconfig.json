{
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "module": "es2022",
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2019"],
    "plugins": [{ "name": "typescript-plugin-css-modules" }],
    "types": ["node", "vite/client"]
  },
  "include": ["src", ".vscode/server/src/databaseService.ts"]
}
